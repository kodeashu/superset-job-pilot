# ==========================================
# SUPERSET JOB PILOT CONFIGURATION
# ==========================================

# 1. Superset Credentials
# Your student login email and password on app.joinsuperset.com
SUPERSET_EMAIL=your_college_email@example.com
SUPERSET_PASSWORD=your_superset_password
# Or if your college uses SSO / Google login, provide your session token:
SUPERSET_TOKEN=

# 2. Telegram Bot Alerts (Instant phone alerts)
# 1) Open Telegram and message @BotFather -> create bot -> copy token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz
# 2) Message @userinfobot on Telegram to get your user chat ID
TELEGRAM_CHAT_ID=123456789

# 2b. Optional: WhatsApp Alerts (Per-student config also available in Dashboard UI)
# Supported providers: local_qr (built-in WhatsApp Linked Devices QR — free & instant), meta, twilio, webhook, callmebot
WHATSAPP_PROVIDER=local_qr
WHATSAPP_BRIDGE_URL=http://127.0.0.1:8091
# International format without '+' (optional for local_qr — defaults to your own WhatsApp "Message Yourself" chat)
WHATSAPP_PHONE=
# Optional: CallMeBot API key (note: CallMeBot free slots are frequently full)
WHATSAPP_API_KEY=
# Optional: Official Meta WhatsApp Business Cloud API
WHATSAPP_META_PHONE_ID=
WHATSAPP_META_TOKEN=
# Optional: Twilio WhatsApp Sandbox / Business API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional: Custom HTTP Webhook (n8n / Make / WAHA)
WHATSAPP_WEBHOOK_URL=

# 3. Auto-Apply Settings
# Set to 'true' to automatically apply to jobs marked ELIGIBLE by Superset
AUTO_APPLY_ELIGIBLE=true
# Name or ID of your default resume uploaded in your Superset profile
DEFAULT_RESUME_NAME=Default_Resume.pdf
# Optional: Minimum package threshold in LPA (e.g., 4.0). 0.0 means all packages
MIN_CTC_LPA=0.0

# 4. Polling & Monitoring Interval
POLL_INTERVAL_MINUTES=15

# 5. Optional: Gmail IMAP Monitoring
# Enable if you want to scan incoming Superset alert emails
ENABLE_GMAIL_MONITOR=false
GMAIL_USER=your_email@gmail.com
# Create a 16-character Google App Password (not your Gmail password):
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# 6. Optional: Google Gemini AI Copilot (Free Tier via Google AI Studio)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
